										<gnt2:BaseRectangle shapeId="{TempSeleccionado>IdLicencia}" countInBirdEye="true" time="{TempSeleccionado>MartesI}" endTime="{TempSeleccionado>MartesF}" resizable="false" selectable="true" draggable="true" showTitle="true" tooltip="" stroke="#01070e" strokeWidth="1" strokeDasharray="" fill="{path: 'TempSeleccionado>EnServicio', formatter: '.formatFill'}" visible="{ parts: [{path: 'TempSeleccionado>MartesI'}, {path: 'TempSeleccionado>MartesF'}], formatter: '.onFormatRectangle'}"/>
