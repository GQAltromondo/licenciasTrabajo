<mvc:View xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:m="sap.m"
	xmlns:gnt2="sap.gantt.simple"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:gnt-cal="sap.gantt.def.cal"
	xmlns:config="sap.gantt.config"
	xmlns:l="sap.ui.layout" height="100vh" controllerName="Transener.Operaciones.LicenciasTrabajo.views.Main.Gantt.Gantt">
	<m:Page showNavButton="false" contentOnlyBusy="true" showHeader="false">
		<m:Panel expandable="true" expanded="true" id="FilterPanel" class="customPanel sapUiMediumMarginBottom">
			<m:headerToolbar class="customPanel">
				<m:Toolbar>

					<core:Icon src="sap-icon://filter" class="textBlue"/>
					<m:Title text="Filtros" class="textBlue"/>
				</m:Toolbar>
			</m:headerToolbar>
			<m:content>
				<m:FlexBox width="95%" class="columns" alignItems="Stretch" justifyContent="Center">
					<m:items>
						<m:FlexBox width="100%" class="columns" alignItems="Stretch" justifyContent="End">
							<m:items>
								<m:Label text="Semana" width="100px">
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Label>
								<m:ComboBox selectedKey="{filters>/week}" items="{selects>/weeks}" width="290px" class="CustomAlign">
									<core:Item key="{selects>code}" text="{selects>text}"/>
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:ComboBox>
								<m:Label text="Año" width="100px">
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Label>
								<m:Select forceSelection="false" selectedKey="{filters>/year}" width="290px" items="{selects>/years}" class="CustomAlign">
									<core:Item key="{selects>code}" text="{selects>text}"/>
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Select>
							</m:items>
							<m:layoutData>
								<m:FlexItemData growFactor="1"/>
							</m:layoutData>
						</m:FlexBox>
					</m:items>
				</m:FlexBox>
				<m:FlexBox width="95%" class="columns" alignItems="Stretch" justifyContent="Center">
					<m:items>
						<m:FlexBox width="100%" class="columns" alignItems="Stretch" justifyContent="Start">
							<m:items>
								<m:Label text="Region" width="100px">
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Label>
								<m:ComboBox selectedKey="{filters>/Region}" width="290px" items="{Regiones>/results}" class="CustomAlign">
									<core:Item key="{Regiones>Werks}" text="{Regiones>Name1}"/>
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:ComboBox>
								<m:Label text="Tipo de Equipo" width="100px">
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Label>
								<m:ComboBox selectedKey="{filters>/Codigo}" width="290px" items="{TipoEquipoJsonModel>/TipoEquipo}" class="CustomAlign">
									<core:Item key="{TipoEquipoJsonModel>Tipo}" text="{TipoEquipoJsonModel>Tipo} - {TipoEquipoJsonModel>Descripcion}"/>
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:ComboBox>
							</m:items>
							<m:layoutData>
								<m:FlexItemData growFactor="1"/>
							</m:layoutData>
						</m:FlexBox>
					</m:items>
				</m:FlexBox>
				<m:FlexBox width="47.5%" class="columns" alignItems="Stretch" justifyContent="Center">
					<m:items>
						<m:FlexBox width="100%" class="columns" alignItems="Stretch" justifyContent="Start">
							<m:items>
								<m:Label text="Estado" width="100px">
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:Label>
								<m:MultiComboBox selectedKeys="{filters>/Licstat}" width="290px" items="{Licstat>/}" class="CustomAlign">
									<core:Item key="{Licstat>key}" text="{Licstat>text}"/>
									<m:layoutData>
										<m:FlexItemData growFactor="1"/>
									</m:layoutData>
								</m:MultiComboBox>
							</m:items>
							<m:layoutData>
								<m:FlexItemData growFactor="1"/>
							</m:layoutData>
						</m:FlexBox>
					</m:items>
				</m:FlexBox>
				<m:FlexBox width="95%">
					<m:items>
						<m:Button text="Buscar" press=".getGanttData"/>
					</m:items>
				</m:FlexBox>
			</m:content>
		</m:Panel>
		<gnt2:GanttChartContainer id="container" enableTimeScrollSync="true">
			<gnt2:toolbar>
				<gnt2:ContainerToolbar id="toolbar" design="Auto" showBirdEyeButton="false" showLegendButton="false">
					<gnt2:legendContainer/>
				</gnt2:ContainerToolbar>
			</gnt2:toolbar>
			<gnt2:ganttCharts>
