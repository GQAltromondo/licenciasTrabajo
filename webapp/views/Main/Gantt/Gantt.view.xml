						</Table>
					</gnt2:table>
					<gnt2:axisTimeStrategy zoomLevel="2">
						<axistime:ProportionZoomStrategy>
							<axistime:totalHorizon>
								<config:TimeHorizon startTime="20251229000000" endTime="20260106000000"/>
							</axistime:totalHorizon>
							<axistime:visibleHorizon>
								<config:TimeHorizon startTime="20251229000000" endTime="20260106000000"/>
							</axistime:visibleHorizon>
						</axistime:ProportionZoomStrategy>
					</gnt2:axisTimeStrategy>
